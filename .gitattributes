# Keep HI05 bundle/report bytes stable for the recorded SHA-256 manifests.
/artifacts/hi05/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
/reports/hi05_*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
/reports/hi05_*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol

# HI05 source fingerprints are recorded with LF line endings.
/src/models/evaluate.py text eol=lf
/src/models/metrics.py text eol=lf
/src/models/predict.py text eol=lf
